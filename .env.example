# Replicate API token. Never commit the real value.
REPLICATE_API_TOKEN=r8_your_token_here
REPLICATE_MODEL=black-forest-labs/flux-2-pro

# Server settings.
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Supabase runtime configuration. SUPABASE_SECRET_KEY is server-only and must
# never be exposed in app.js, index.html, or any browser bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Required when NODE_ENV=production, for example https://app.example.com
PUBLIC_ORIGIN=
TRUST_PROXY=false

# Generated image files still require a persistent disk in production.
GENERATED_DIR=./generated

# Optional Replicate tuning.
REPLICATE_SAFETY_TOLERANCE=2
REPLICATE_OUTPUT_QUALITY=90
REPLICATE_TIMEOUT_MS=300000
