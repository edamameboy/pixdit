{
    email {$ACME_EMAIL}
}

{$LAYERA_PUBLIC_HOST} {
    encode zstd gzip

    request_body {
        max_size 1MB
    }

    reverse_proxy 127.0.0.1:8001 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Host {host}
    }

    header {
        -Server
    }
}
